        <sql>UPDATE playnite_change
             SET type = 'COMPLETION_STATUS'
             WHERE type = 'CompletionStatus'</sql>
        <sql>UPDATE playnite_change
             SET type = 'FILTER_PRESET'
             WHERE type = 'FilterPreset'</sql>
        <sql>UPDATE playnite_change
             SET type = 'GAME'
             WHERE type = 'Game'</sql>
        <sql>UPDATE playnite_change
             SET type = 'GAME_DIFF'
             WHERE type = 'GameDiff'</sql>
        <rollback>
            <sql>UPDATE playnite_change SET type = 'Category' WHERE type = 'CATEGORY'</sql>
            <sql>UPDATE playnite_change SET type = 'Genre' WHERE type = 'GENRE'</sql>
            <sql>UPDATE playnite_change SET type = 'Platform' WHERE type = 'PLATFORM'</sql>
            <sql>UPDATE playnite_change SET type = 'PlatformDiff' WHERE type = 'PLATFORM_DIFF'</sql>
            <sql>UPDATE playnite_change SET type = 'Company' WHERE type = 'COMPANY'</sql>
