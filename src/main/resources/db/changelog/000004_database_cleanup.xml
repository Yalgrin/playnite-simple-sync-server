            <sql>UPDATE playnite_change SET type = 'Region' WHERE type = 'REGION'</sql>
            <sql>UPDATE playnite_change SET type = 'Source' WHERE type = 'SOURCE'</sql>
            <sql>UPDATE playnite_change SET type = 'CompletionStatus' WHERE type = 'COMPLETION_STATUS'</sql>
            <sql>UPDATE playnite_change SET type = 'FilterPreset' WHERE type = 'FILTER_PRESET'</sql>
            <sql>UPDATE playnite_change SET type = 'Game' WHERE type = 'GAME'</sql>
            <sql>UPDATE playnite_change SET type = 'GameDiff' WHERE type = 'GAME_DIFF'</sql>
        </rollback>
